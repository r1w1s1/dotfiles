! ~/.Xresources
! Load/reload with:
!   xrdb -load ~/.Xresources

! ==============================
!  Global Xft
! ==============================
Xft.dpi: 112

! ==============================
!  XTerm (class: XTerm)
! ==============================

! --- Fonts ---
XTerm*faceName: Iosevka Term
XTerm*faceSize: 11

! --- Padding ---
XTerm*internalBorder: 8

! --- Behavior ---
XTerm*utf8: 1
XTerm*termName: xterm-256color
XTerm*saveLines: 1000
! Match st cursorshape = 6: steady, thicker bar cursor; no blinking prompt.
XTerm*cursorBlink: false
XTerm*cursorShape: bar
XTerm*cursorBarWidth: 2

! --- Scrollbar ---
XTerm*scrollBar: true
XTerm*rightScrollBar: true
XTerm*scrollBarThickness: 10

! --- SIXEL (if your xterm build supports it) ---
XTerm*sixelMode: true
XTerm*sixelScrolling: true
XTerm*decTerminalID: vt340

! --- Colors ---
XTerm*background: #000000
XTerm*foreground: #ffffff

XTerm*color0:  #000000
XTerm*color1:  #ff0000
XTerm*color2:  #00ff00
XTerm*color3:  #ffff00
XTerm*color4:  #0000ff
XTerm*color5:  #ff00ff
XTerm*color6:  #00ffff
XTerm*color7:  #ffffff

XTerm*color8:  #555555
XTerm*color9:  #ff5555
XTerm*color10: #55ff55
XTerm*color11: #ffff55
XTerm*color12: #5555ff
XTerm*color13: #ff55ff
XTerm*color14: #55ffff
XTerm*color15: #ffffff

! --- Clipboard bindings (robust) ---
! Ctrl+Shift+C copies selection to CLIPBOARD
! Ctrl+Shift+V pastes CLIPBOARD
XTerm*VT100.Translations: #override \
  Ctrl Shift <KeyPress>C: copy-selection(CLIPBOARD) \n\
  Ctrl Shift <KeyPress>V: insert-selection(CLIPBOARD)

! ==============================
!  UXTerm (only if you run uxterm)
!  (uxterm uses class UXTerm, so duplicate the important bits)
! ==============================
UXTerm*faceName: Iosevka Term
UXTerm*faceSize: 11
UXTerm*internalBorder: 8
UXTerm*termName: xterm-256color
UXTerm*saveLines: 1000
! UXTerm*cursorBlink: true
UXTerm*scrollBar: true
UXTerm*rightScrollBar: true
UXTerm*scrollBarThickness: 10
UXTerm*background: #000000
UXTerm*foreground: #ffffff
UXTerm*VT100.Translations: #override \
  Ctrl Shift <KeyPress>C: copy-selection(CLIPBOARD) \n\
  Ctrl Shift <KeyPress>V: insert-selection(CLIPBOARD)

! ==============================
!  XClock
! ==============================
XClock*update: 1
XClock*analog: False
XClock*render: True
XClock*padding: 4
XClock*face: Liberation Sans:size=20
XClock*strftime: %a %b %d  %H:%M

! ==============================
!  XCalc
! ==============================
xcalc*font: -b&h-lucida-medium-r-*-*-16-*-*-*-*-*-*-*
xcalc*Cursor: hand2
xcalc*ShapeStyle: rectangle
xcalc*ti.button1.vertDistance: 4
xcalc*ti.button2.vertDistance: 4
xcalc*ti.button3.vertDistance: 4
xcalc*ti.button4.vertDistance: 4
xcalc*ti.button5.vertDistance: 4
xcalc*ti.background: gray90
xcalc*ti.bevel.borderColor: gray65
xcalc*ti.bevel.borderWidth: 1
xcalc*ti.bevel.vertDistance: 4
xcalc*ti.bevel.defaultDistance: 0
xcalc*ti.bevel.background: rgb:b/c/b
xcalc*ti.bevel.screen*background: rgb:b/c/b
xcalc*ti.bevel.screen.borderColor: rgb:b/c/b
xcalc*ti.bevel.screen.vertDistance: 10
xcalc*ti.bevel.screen.horizDistance: 10
xcalc*ti.bevel.screen*left: chainLeft
xcalc*ti.bevel.screen*right: chainRight
xcalc*ti.bevel.screen*top: chainTop
xcalc*ti.bevel.screen*bottom: chainBottom
xcalc*ti.bevel.screen*LCD.foreground: gray10
xcalc*ti.bevel.screen*INV.vertDistance: 0
xcalc*ti.Command.borderColor: gray65
xcalc*ti.Command.background: gray85
xcalc*ti.Command.foreground: gray30
xcalc*ti.button5.background: rgb:e/b/b
xcalc*ti.button20.background: rgb:e/d/c
xcalc*ti.button25.background: rgb:e/d/c
xcalc*ti.button30.background: rgb:e/d/c
XCalc.ti.button35.label: /
xcalc*ti.button35.background: rgb:e/d/c
xcalc*ti.button40.background: rgb:b/b/e
xcalc*ti.button22.background: gray95
xcalc*ti.button23.background: gray95
xcalc*ti.button24.background: gray95
xcalc*ti.button27.background: gray95
xcalc*ti.button28.background: gray95
xcalc*ti.button29.background: gray95
xcalc*ti.button32.background: gray95
xcalc*ti.button33.background: gray95
xcalc*ti.button34.background: gray95
xcalc*ti.button37.background: gray95
xcalc*ti.button38.background: gray95
xcalc*ti.button39.background: gray95

! ==============================
!  xosview
! ==============================
xosview*background: #222222
xosview*borderwidth: 0

! ==============================
!  xload
! ==============================
XLoad*font: -adobe-helvetica-medium-r-normal--14-140-75-75-p-77-iso10646-*

! ==============================
!  xmenu
! ==============================
xmenu.font: Iosevka Term:size=11
xmenu.background: #1c1c1c
xmenu.foreground: #cccccc
xmenu.selbackground: #e0b800
xmenu.selforeground: #000000

xmenu.border: #e0b800
xmenu.borderWidth: 2

xmenu.separator: #555555
xmenu.separatorWidth: 1

xmenu.gap: 4
xmenu.height: 22
xmenu.width: 180
