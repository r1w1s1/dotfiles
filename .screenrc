# No welcome message
startup_message off

# Lower Esc delay for responsive key handling
maptimeout 5

# Enable mouse support for scroll wheel and panel switching (all windows).
mousetrack on
defmousetrack on

# Clear with current background color
defbce on

# 256 color support
term screen-256color

# Keep 5000 lines of history per window
defscrollback 5000

# UTF-8 encoding
defutf8 on

# Window list at the bottom
#caption always "%{= kw}%-w%{= BW}%n %t%{-}%+w"

# hjkl to switch panels (vim-style)
bind h focus left               # Ctrl+A + h = ←
bind j focus down               # Ctrl+A + j = ↓
bind k focus up                 # Ctrl+A + k = ↑
bind l focus right              # Ctrl+A + l = →

# Split + auto-create shell (tmux-style behavior, default keys)
bind S eval "split"     "focus" "screen"   # Ctrl+A + S = horizontal split with shell
bind | eval "split -v"  "focus" "screen"   # Ctrl+A + | = vertical split with shell 

# Neutralize the dangerous quit binding from /etc/screenrc
bind \\
