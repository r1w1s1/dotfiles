#!/bin/sh

ROOT=sudo

# Open terminal with command
term() {
    
    st -t "$1" -e "${@:2}"
}

termbig() {
    st -g 140x40 -t "$1" -e "${@:2}"
}

termtab() {
    tabbed -c -n termtab -r 2 st -w '' -e tmux
}

#termtab() {
#    tabbed -c -n termtab -r 2 xterm -into '' -e tmux
#}

choice=$(printf "%s\n" \
    "browser" \
    "terminal" \
    "termtab"  \
    "irc" \
    "scratch" \
    "mail" \
    "pdf" \
    "editor" \
    "files" \
    "mixer" \
    "wifi" \
    "bluetooth" \
    "htop" \
    "reboot" \
    "shutdown" |
    dmenu -i -l 14 -p "Menu")

case "$choice" in
    browser)    firefox ;;
    terminal)   term terminal tmux ;;
    termtab)    termtab ;;
    irc)        termbig senpai senpai ;;
    scratch)    term scratch ~/.bin/scratch ;;
    mail)       term mutt mutt ;;
    pdf)        pdf-open.sh ;;
    editor)     geany ;;
    files)      termbig dfm dfm ;;
    mixer)      pavucontrol ;;
    wifi)       termbig wifitui "$ROOT" wifitui ;;
    htop)       termbig htop htop ;;
    bluetooth)  blueman-manager ;;
    reboot)     "$ROOT" /sbin/reboot ;;
    shutdown)   "$ROOT" /sbin/poweroff ;;
esac
