" desliga syntax highlight
syntax off

" sem arquivos de backup
set nobackup
set noswapfile
set noundofile

" sem modo visual desnecessário
set noshowmode

" sem ruler
set noruler

" sem status line
set laststatus=0

" sem highlight de busca piscando
set nohlsearch

" sem mouse
set mouse=

" sem bells
set noeb vb t_vb=
